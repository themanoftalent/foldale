{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Foldale main window. Filesystem access goes through Foldale's own audited commands, not the generic fs plugin.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-toggle-maximize",
    "dialog:default",
    "window-state:default"
  ]
}
